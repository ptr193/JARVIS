<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#E61C1916"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/assist_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:text="@string/assist_brand"
        android:textColor="#FFD54F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <com.jarvis.pineapple.assistant.VoiceWaveformView
        android:id="@+id/assist_waveform"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/assist_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/assist_listening"
        android:textColor="#E6FFFFFF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/assist_object"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/assist_object" />

        <Button
            android:id="@+id/assist_document"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/assist_document" />
    </LinearLayout>
</LinearLayout>
